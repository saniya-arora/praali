{%- comment -%}
  Back-in-stock signup modal (Klaviyo). Opened by JS when a shopper picks a
  sold-out size on a product card or in the product detail modal.
{%- endcomment -%}

<div class="restock-modal" id="restockModal" data-restock-modal hidden>
  <div class="restock-modal-overlay" data-restock-close></div>
  <div class="restock-modal-content" role="dialog" aria-modal="true" aria-labelledby="restockModalTitle">
    <button class="restock-modal-close" type="button" data-restock-close aria-label="Close">&times;</button>

    <h2 class="restock-modal-heading" id="restockModalTitle">{{ 'products.product.restock_heading' | t }}</h2>
    <p class="restock-modal-body" data-restock-label></p>

    <form class="restock-modal-form" data-restock-form novalidate>
      <input
        type="email"
        name="email"
        data-restock-email
        placeholder="{{ 'products.product.restock_email_placeholder' | t }}"
        aria-label="{{ 'products.product.restock_email_placeholder' | t }}"
        autocomplete="email"
        required
      />
      <button type="submit" data-restock-submit>{{ 'products.product.restock_submit' | t }}</button>
    </form>

    <p class="restock-modal-consent">{{ 'products.product.restock_consent' | t }}</p>

    <p class="restock-modal-success" data-restock-success hidden>{{ 'products.product.restock_success' | t }}</p>
    <p class="restock-modal-error" data-restock-error hidden></p>
  </div>
</div>
