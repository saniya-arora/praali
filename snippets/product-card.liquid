{%- comment -%}
  Renders a product card for the homepage grid.
  Expects: product, idx
{%- endcomment -%}

{%- assign color_option_name = 'Color' -%}
{%- assign color_option = product.options_by_name[color_option_name] -%}
{%- assign size_option = product.options_by_name['Size'] -%}
{%- assign default_variant = product.selected_or_first_available_variant -%}
{%- assign color_pos = color_option.position | default: 1 -%}
{%- assign size_pos = size_option.position | default: 2 -%}

{%- capture card_variants_json -%}
[{% for variant in product.variants %}{%- if color_pos == 1 -%}{%- assign v_color = variant.option1 -%}{%- elsif color_pos == 2 -%}{%- assign v_color = variant.option2 -%}{%- else -%}{%- assign v_color = variant.option3 -%}{%- endif -%}{%- if size_pos == 1 -%}{%- assign v_size = variant.option1 -%}{%- elsif size_pos == 2 -%}{%- assign v_size = variant.option2 -%}{%- else -%}{%- assign v_size = variant.option3 -%}{%- endif -%}{"id":{{ variant.id }},"color":{{ v_color | json }},"size":{{ v_size | json }},"option1":{{ variant.option1 | json }},"option2":{{ variant.option2 | json }},"option3":{{ variant.option3 | json }},"available":{{ variant.available | json }},"inventory_management":{{ variant.inventory_management | json }},"inventory_quantity":{{ variant.inventory_quantity | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
{%- endcapture -%}

<article class="product-card"
         data-product="{{ idx }}"
         data-variants="{{ card_variants_json | strip | escape }}">
  <button class="product-image" data-modal-open="{{ idx }}" aria-label="View {{ product.title }} details">
    {%- if default_variant.featured_image -%}
      <img src="{{ default_variant.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" />
    {%- elsif product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" />
    {%- else -%}
      <span class="img-label">{{ product.title }}</span>
    {%- endif -%}
  </button>

  {%- if color_option -%}
    <div class="color-swatches">
      {%- for value in color_option.values -%}
        {%- assign swatch_hex = value | downcase | replace: ' ', '-' -%}
        {%- case swatch_hex -%}
          {%- when 'cayenne' -%}{% assign hex = '#9C3E32' %}
          {%- when 'lilac' -%}{% assign hex = '#C4ADD4' %}
          {%- when 'sage-green' or 'sage' -%}{% assign hex = '#A9B48B' %}
          {%- else -%}{% assign hex = '#A9B48B' %}
        {%- endcase -%}
        <button class="swatch{% if value == color_option.selected_value %} is-active{% endif %}"
                data-color="{{ forloop.index0 }}"
                data-value="{{ value }}"
                style="background: {{ hex }};"
                aria-label="{{ value }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <h3 class="product-name" data-modal-open="{{ idx }}" role="button" tabindex="0">{{ product.title }}</h3>
  <p class="product-price">{{ default_variant.price | money }}</p>

  {%- assign size_option = product.options_by_name['Size'] -%}
  {%- if size_option -%}
    <div class="card-section">
      <span class="card-section-label">Size</span>
      <div class="size-options" data-card-sizes>
        {%- for value in size_option.values -%}
          <button class="size-option" data-value="{{ value }}">{{ value }}</button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="product-actions" data-product-actions>
    {%- if product.available -%}
      <button class="btn btn-primary" type="button" data-add-to-cart>{{ 'products.product.add_to_cart' | t }}</button>
      <button class="btn btn-secondary" type="button" data-buy-now>{{ 'products.product.buy_now' | t }}</button>
    {%- else -%}
      <button class="btn btn-primary is-sold-out" type="button" disabled aria-disabled="true">{{ 'products.product.sold_out' | t }}</button>
    {%- endif -%}
  </div>
  {% render 'restock-notify', wrapper_class: 'restock-notify--card' %}
  <button class="details-link" data-modal-open="{{ idx }}">View details</button>
</article>
